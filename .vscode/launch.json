{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TeamSync: Dev Server (Vite)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    },
    {
      "name": "TeamSync: Backend Server (Node.js)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "console": "integratedTerminal"
    },
    {
      "name": "TeamSync: Full-Stack Dev (npx tsx)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "server.ts"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
